# Ollama Cloud — separar keys solo con coma (sin comillas).
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TOKENS=tu_token_1,tu_token_2,tu_token_3

# Embeddings: fastembed (local ONNX, recomendado) | ollama (si tu plan lo permite)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Persistencia
DATABASE_URL=sqlite+aiosqlite:///./data/rag.db
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=160
TOP_K=7
MIN_RELEVANCE=0.25
LLM_TEMPERATURE=0.2
MAX_PDF_PAGES=80
